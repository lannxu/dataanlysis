{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talent-review-3",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [{"name": "REVIEW_STATE", "class_name": "ReviewState"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ReviewState"]}],
  "r2_buckets": [{"binding": "PHOTOS", "bucket_name": "talent-review-photos"}],
  "vars": {"ALLOW_MIGRATION": "false"},
  "observability": {"enabled": true}
}
